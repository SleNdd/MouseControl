<Window x:Class="MouseControl.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid x:Name="Root" Background="Transparent" KeyDown="Root_KeyDown">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid Grid.Row="0" Margin="14,4,18,0" ColumnSpacing="12">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TabView x:Name="ProfileTabs" Height="44" IsAddTabButtonVisible="True" CanDragTabs="False" CanReorderTabs="False" TabWidthMode="SizeToContent" AddTabButtonClick="AddProfile_Click" TabCloseRequested="Profile_CloseRequested" SelectionChanged="Profile_SelectionChanged"/>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
        <ToggleSwitch x:Name="EnabledSwitch" OnContent="Enabled" OffContent="Enabled" Toggled="Enabled_Toggled" AutomationProperties.Name="Enable cursor movement"/>
        <TextBlock x:Name="StatusText" Text="Disabled" VerticalAlignment="Center" FontSize="12" Opacity="0.7"/>
      </StackPanel>
    </Grid>
    <InfoBar x:Name="Notice" Grid.Row="1" Margin="18,4" IsOpen="False" IsClosable="True" Severity="Informational"/>
    <ScrollViewer Grid.Row="2" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Center">
    <Grid Margin="22,12,22,4" ColumnSpacing="24" VerticalAlignment="Center">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="236"/></Grid.ColumnDefinitions>
      <StackPanel Spacing="16" VerticalAlignment="Center">
        <StackPanel Spacing="2">
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="112"/></Grid.ColumnDefinitions>
            <TextBlock Text="Vertical" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <NumberBox x:Name="VerticalNumber" Grid.Column="1" Minimum="-2000" Maximum="2000" SmallChange="1" SpinButtonPlacementMode="Hidden" Loaded="Number_Loaded" ValueChanged="Number_Changed" AutomationProperties.Name="Vertical speed in input units per second"/>
          </Grid>
          <Slider x:Name="VerticalSlider" Minimum="-2000" Maximum="2000" StepFrequency="1" ValueChanged="Slider_Changed" DoubleTapped="Vertical_Reset" AutomationProperties.Name="Vertical: up to down"/>
          <Grid><TextBlock Text="Up −2000" FontSize="11" Opacity="0.65"/><TextBlock Text="units/s" FontSize="11" Opacity="0.65" HorizontalAlignment="Center"/><TextBlock Text="+2000 Down" FontSize="11" Opacity="0.65" HorizontalAlignment="Right"/></Grid>
        </StackPanel>
        <StackPanel Spacing="2">
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="112"/></Grid.ColumnDefinitions>
            <TextBlock Text="Horizontal" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <NumberBox x:Name="HorizontalNumber" Grid.Column="1" Minimum="-2000" Maximum="2000" SmallChange="1" SpinButtonPlacementMode="Hidden" Loaded="Number_Loaded" ValueChanged="Number_Changed" AutomationProperties.Name="Horizontal speed in input units per second"/>
          </Grid>
          <Slider x:Name="HorizontalSlider" Minimum="-2000" Maximum="2000" StepFrequency="1" ValueChanged="Slider_Changed" DoubleTapped="Horizontal_Reset" AutomationProperties.Name="Horizontal: left to right"/>
          <Grid><TextBlock Text="Left −2000" FontSize="11" Opacity="0.65"/><TextBlock Text="units/s" FontSize="11" Opacity="0.65" HorizontalAlignment="Center"/><TextBlock Text="+2000 Right" FontSize="11" Opacity="0.65" HorizontalAlignment="Right"/></Grid>
        </StackPanel>
        <StackPanel Spacing="2">
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="84"/></Grid.ColumnDefinitions>
            <TextBlock Text="Humanization" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <NumberBox x:Name="HumanNumber" Grid.Column="1" Minimum="0" Maximum="100" SmallChange="1" SpinButtonPlacementMode="Hidden" Loaded="Number_Loaded" ValueChanged="Number_Changed" AutomationProperties.Name="Humanization percent"/>
          </Grid>
          <Slider x:Name="HumanSlider" Minimum="0" Maximum="100" StepFrequency="1" ValueChanged="Slider_Changed" AutomationProperties.Name="Humanization strength"/>
          <Grid><TextBlock Text="0%" FontSize="11" Opacity="0.65"/><TextBlock Text="100%" FontSize="11" Opacity="0.65" HorizontalAlignment="Right"/></Grid>
        </StackPanel>
      </StackPanel>
      <StackPanel Grid.Column="1" Spacing="7">
        <Grid><TextBlock Text="Direction" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="X / Y" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center" Opacity="0.6"/></Grid>
        <Button x:Name="PadButton" Padding="0" Width="236" Height="236" Background="Transparent" BorderThickness="1" CornerRadius="8" KeyDown="Pad_KeyDown" AutomationProperties.Name="Direction pad. Arrow keys adjust, double click resets.">
          <Canvas x:Name="PadCanvas" Width="234" Height="234" Background="Transparent" PointerPressed="Pad_Pressed" PointerMoved="Pad_Moved" PointerReleased="Pad_Released" PointerCaptureLost="Pad_CaptureLost" DoubleTapped="Pad_Reset"/>
        </Button>
        <Button x:Name="PreviewButton" Click="Preview_Click" HorizontalAlignment="Stretch" ToolTipService.ToolTip="Local 1.5-second preview, scaled to fit the pad.">
          <StackPanel Orientation="Horizontal" Spacing="8"><SymbolIcon Symbol="Play"/><TextBlock x:Name="PreviewText" Text="Preview"/></StackPanel>
        </Button>
      </StackPanel>
    </Grid>
    </ScrollViewer>
    <Grid Grid.Row="3" Margin="22,12,22,2" ColumnSpacing="12">
      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="156"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBlock Text="Activate on" VerticalAlignment="Center" FontSize="13"/>
      <ComboBox x:Name="ActivationCombo" Grid.Column="1" HorizontalAlignment="Stretch" SelectionChanged="Activation_Changed" AutomationProperties.Name="Hold to activate">
        <ComboBoxItem Content="LMB"/><ComboBoxItem Content="RMB"/><ComboBoxItem Content="LMB + RMB"/><ComboBoxItem Content="MMB"/><ComboBoxItem Content="Alt"/><ComboBoxItem Content="Shift"/>
      </ComboBox>
      <TextBlock Grid.Column="2" Text="Toggle key" VerticalAlignment="Center" FontSize="13"/>
      <Button x:Name="HotkeyButton" Grid.Column="3" Content="F8" Click="Hotkey_Click" HorizontalAlignment="Stretch" AutomationProperties.Name="Capture global toggle key"/>
      <Button Grid.Column="4" Click="Settings_Click" ToolTipService.ToolTip="Settings" AutomationProperties.Name="Settings"><SymbolIcon Symbol="Setting"/></Button>
      <Button Grid.Column="5" Click="Tray_Click" ToolTipService.ToolTip="Minimize to tray" AutomationProperties.Name="Minimize to tray"><FontIcon Glyph="&#xE8A7;"/></Button>
    </Grid>
    <Grid Grid.Row="4" Margin="22,4,22,10">
      <StackPanel Orientation="Horizontal" Spacing="14">
        <ComboBox x:Name="ModelCombo" MinWidth="126" FontSize="11" MinHeight="28" SelectionChanged="Model_Changed" AutomationProperties.Name="Humanization algorithm"/>
        <CheckBox x:Name="PulseEffectCheck" Content="Pulse" MinWidth="0" MinHeight="28" FontSize="11" Checked="Effects_Changed" Unchecked="Effects_Changed" ToolTipService.ToolTip="Vary movement in smooth bursts. Uses Humanization strength."/>
        <CheckBox x:Name="CorrectionEffectCheck" Content="Nonlinearity" MinWidth="0" MinHeight="28" FontSize="11" Checked="Effects_Changed" Unchecked="Effects_Changed" ToolTipService.ToolTip="Add changes in direction and speed. Uses Humanization strength."/>
        <StackPanel x:Name="ArduinoStatus" Orientation="Horizontal" Spacing="6" Visibility="Collapsed" VerticalAlignment="Center">
          <Ellipse x:Name="ArduinoLamp" Width="7" Height="7" VerticalAlignment="Center"/>
          <TextBlock x:Name="ArduinoStatusText" Text="Offline" FontSize="11"/>
        </StackPanel>
      </StackPanel>
      <TextBlock Text="prod. by SleNdd" FontSize="11" Opacity="0.7" HorizontalAlignment="Right" VerticalAlignment="Center"/>
    </Grid>
  </Grid>
</Window>
