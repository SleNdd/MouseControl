<Project>
  <PropertyGroup>
    <BaseOutputPath>.artifacts/bin/</BaseOutputPath>
    <BaseIntermediateOutputPath>.artifacts/obj/</BaseIntermediateOutputPath>
  </PropertyGroup>
  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="RuntimeChecks.txt" />
    <Compile Include="BackendChecks.txt" />
    <Compile Include="MotionUiChecks.txt" />
    <Compile Include="../RuntimeService.cs" Link="RuntimeService.cs" />
    <Compile Include="../InputBackends.cs" Link="InputBackends.cs" />
    <Compile Include="../MotionUi.cs" Link="MotionUi.cs" />
    <Compile Include="../OutputScheduler.cs" Link="OutputScheduler.cs" />
    <Compile Include="../Arduino*.cs" Link="%(Filename).cs" />
    <Compile Include="../WindowBridge.cs" Link="WindowBridge.cs" />
    <Compile Include="../../Native.cs" Link="Native.cs" />
    <ProjectReference Include="../../../MouseControl.Core/MouseControl.Core.csproj" />
    <PackageReference Include="System.IO.Ports" Version="10.0.0" />
  </ItemGroup>
  <Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk" />
</Project>
