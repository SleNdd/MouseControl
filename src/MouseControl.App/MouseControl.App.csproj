<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <!-- MRT also recognizes this common name after the published EXE is renamed. -->
    <ProjectPriFileName>resources.pri</ProjectPriFileName>
    <EnableMsixTooling>true</EnableMsixTooling>
    <PublishSingleFile>false</PublishSingleFile>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <WindowsAppSdkBootstrapInitialize>false</WindowsAppSdkBootstrapInitialize>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <SelfContained>true</SelfContained>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>MouseControl.App</AssemblyName>
    <RootNamespace>MouseControl.App</RootNamespace>
    <Version>0.5.0</Version>
    <Authors>SleNdd</Authors>
    <Company>SleNdd</Company>
    <Product>MouseControl</Product>
    <Copyright>Copyright © SleNdd</Copyright>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260921001" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.4654" />
    <PackageReference Include="System.IO.Ports" Version="10.0.0" />
    <PackageReference Include="NAudio.Wasapi" Version="2.3.0" />
    <ProjectReference Include="../MouseControl.Core/MouseControl.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="../MouseControl.Launcher/ProcessMasker.cs" Link="Masking/ProcessMasker.cs" />
    <Compile Include="../MouseControl.Launcher/ExecutableResources.cs" Link="Masking/ExecutableResources.cs" />
    <EmbeddedResource Include="ThirdParty/LICENSE.NAudio.txt" LogicalName="MouseControl.NAudio.License" />
  </ItemGroup>
  <Import Project="../../scripts/ObfuscateCore.targets" />
</Project>
