<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../src/MouseControl.Launcher/ProcessMasker.cs" Link="ProcessMasker.cs" />
    <Compile Include="../../src/MouseControl.Launcher/ExecutableResources.cs" Link="ExecutableResources.cs" />
    <Compile Include="../../src/MouseControl.Launcher/RuntimeCache.cs" Link="RuntimeCache.cs" />
  </ItemGroup>
</Project>
