<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup Condition="'$(ObfuscatedCorePath)' == ''">
    <ProjectReference Include="../../src/MouseControl.Core/MouseControl.Core.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(ObfuscatedCorePath)' != ''">
    <Reference Include="MouseControl.Core">
      <HintPath>$(ObfuscatedCorePath)</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>
</Project>
